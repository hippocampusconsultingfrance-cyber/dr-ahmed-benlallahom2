# Variables d'environnement — Dr. Ahmed Ben Lallahom
#
# Copier ce fichier en `.env` pour le développement local (jamais commité).
# En production, définir les valeurs dans Vercel > Settings > Environment Variables.
# Les variables marquées [requis prod] sont vérifiées au démarrage
# (server/_core/env.ts, PRODUCTION_REQUIRED_ENVIRONMENT_VARIABLES).
# Les variables préfixées VITE_ ou NEXT_PUBLIC_ sont intégrées au bundle
# navigateur : n'y mettez jamais de secret.

# --- Base de données (Neon PostgreSQL) -------------------------------------
DATABASE_URL=                       # [requis prod] postgres://…

# --- Application ------------------------------------------------------------
PUBLIC_APP_ORIGIN=https://drahmedbenlallahom.com
JWT_SECRET=                         # [requis prod] secret de signature des cookies (≥ 32 caractères)
PORT=3000                           # serveur Express local uniquement

# --- Authentification administrateur (Clerk) --------------------------------
CLERK_SECRET_KEY=                   # [requis prod]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # [requis prod] clé publique, exposée au navigateur
CLERK_OWNER_USER_ID=                # identifiant Clerk du compte administrateur

# --- Paiement (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=                  # [requis prod] sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=              # [requis prod] whsec_… (endpoint /api/stripe/webhook)

# --- Emails (Resend) --------------------------------------------------------
RESEND_API_KEY=                     # [requis prod]
RESEND_WEBHOOK_SECRET=              # signature Svix de /api/webhooks/resend
OWNER_NOTIFICATION_EMAIL=           # destinataire des alertes (paiement non confirmable, échecs d'envoi…)

# --- Anti-robot (Cloudflare Turnstile) --------------------------------------
TURNSTILE_SECRET_KEY=               # [requis prod]
VITE_TURNSTILE_SITE_KEY=            # clé publique du widget

# --- Espace candidat ---------------------------------------------------------
CANDIDATE_AUTH_PEPPER=              # [requis prod] ≥ 32 caractères aléatoires
CANDIDATE_DOCUMENT_ENCRYPTION_KEY=  # [requis prod] clé AES-256 en base64 (32 octets)

# --- Stockage de fichiers (Vercel Blob) -------------------------------------
BLOB_READ_WRITE_TOKEN=              # [requis prod]

# --- Tâches planifiées (Vercel Cron) ----------------------------------------
CRON_SECRET=                        # ≥ 32 caractères ; sans elle, toutes les tâches /api/scheduled/* sont refusées (403)

# --- Export des CV vers Google Drive (optionnel) ----------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_CV_FOLDER_ID=

# --- Analytics (optionnel, chargé après consentement) -----------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Héritage plateforme Manus (à retirer après migration complète) ---------
# Utilisées par le proxy /manus-storage, l'ancien OAuth et les tâches POST Manus.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Tests (développement uniquement) ---------------------------------------
# RUN_EXTERNAL_SECURITY_TESTS=false   # true = tests qui appellent Resend/Turnstile réels
# VISUAL_TEST_BASE_URL=http://localhost:3000
