# Variables d'environnement — Dr. Ahmed Ben Lallahom
#
# Copier ce fichier en `.env` pour le développement local (jamais commité).
# En production, définir les valeurs dans Vercel > Settings > Environment Variables.
# Les variables marquées [requis prod] sont vérifiées au démarrage
# (server/_core/env.ts, PRODUCTION_REQUIRED_ENVIRONMENT_VARIABLES) : le serveur
# Express refuse de démarrer ; sur Vercel, la fonction démarre quand même mais
# journalise une erreur [Config] CRITICAL, et la liste des NOMS manquants est
# visible sur GET /api/health (503 tant qu’il en manque) et dans /admin.
# Les variables préfixées VITE_ ou NEXT_PUBLIC_ sont intégrées au bundle
# navigateur : n'y mettez jamais de secret.

# --- Base de données (Neon PostgreSQL) -------------------------------------
DATABASE_URL=                       # [requis prod] postgres://…

# --- Application ------------------------------------------------------------
PUBLIC_APP_ORIGIN=https://drahmedbenlallahom.com
JWT_SECRET=                         # [requis prod] secret de signature des cookies (≥ 32 caractères)
PORT=3000                           # serveur Express local uniquement

# --- Authentification administrateur (Clerk) --------------------------------
CLERK_SECRET_KEY=                   # [requis prod]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # [requis prod] clé publique, exposée au navigateur (sert aussi au serveur si CLERK_PUBLISHABLE_KEY est vide)
CLERK_PUBLISHABLE_KEY=              # optionnel : même clé publique, lue par clerkMiddleware côté serveur
CLERK_OWNER_USER_ID=                # [requis prod] identifiant Clerk du compte administrateur (instance PROD)

# --- Paiement (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=                  # [requis prod] sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=              # [requis prod] whsec_… (endpoint /api/stripe/webhook)
# Évènements à cocher sur cet endpoint dans Stripe : checkout.session.completed,
# checkout.session.expired, charge.refunded (remboursement fait dans Stripe) et
# charge.dispute.created (contestation bancaire). Après chaque changement du
# secret : « Send test webhook » depuis Stripe.

# --- Facturation (optionnel, voir server/invoiceSeller.ts) ------------------
# Par défaut la facture reprend l'identité publiée dans les mentions légales
# (shared/legalIdentity.ts). Aucune mention de TVA n'est imprimée sans
# INVOICE_VAT_MENTION : texte exact à faire valider par l'expert-comptable.
INVOICE_VAT_MENTION=
INVOICE_SELLER_VAT_NUMBER=          # n° de TVA intracommunautaire, si applicable
# INVOICE_SELLER_NAME= / INVOICE_SELLER_LEGAL_FORM= / INVOICE_SELLER_CAPITAL=
# INVOICE_SELLER_RCS= / INVOICE_SELLER_ADDRESS= / INVOICE_SELLER_EMAIL=

# --- Emails (Resend) --------------------------------------------------------
RESEND_API_KEY=                     # [requis prod]
RESEND_WEBHOOK_SECRET=              # [requis prod] signature Svix de /api/webhooks/resend
OWNER_NOTIFICATION_EMAIL=           # destinataire des alertes (paiement non confirmable, échecs d'envoi…)
# Emails patients (confirmation, facture, rappel, remboursement), voir server/consultationContact.ts.
# Par défaut : Reply-To = email de contact public du site (client/src/data/site-config.ts),
# expéditeur transactionnel inchangé, aucune modalité de consultation imprimée.
CONSULTATION_REPLY_TO=              # boîte surveillée qui reçoit les réponses des patients
CONSULTATION_FROM_EMAIL=            # ex. "Dr Ahmed Ben Lallahom <consultation@drahmedbenlallahom.com>" (domaine vérifié Resend)
CONSULTATION_MODALITY_TEXT=         # déroulement (appel au numéro fourni, lien visio…), validé par le praticien

# --- Anti-robot (Cloudflare Turnstile) --------------------------------------
TURNSTILE_SECRET_KEY=               # [requis prod]
VITE_TURNSTILE_SITE_KEY=            # clé publique du widget

# --- Espace candidat ---------------------------------------------------------
CANDIDATE_AUTH_PEPPER=              # [requis prod] ≥ 32 caractères aléatoires
CANDIDATE_DOCUMENT_ENCRYPTION_KEY=  # [requis prod] clé AES-256 en base64 (32 octets)

# --- Stockage de fichiers (Vercel Blob) -------------------------------------
BLOB_READ_WRITE_TOKEN=              # [requis prod]

# --- Tâches planifiées (Vercel Cron) ----------------------------------------
CRON_SECRET=                        # [requis prod] ≥ 32 caractères ; sans elle, toutes les tâches /api/scheduled/* sont refusées (403)

# --- Export des CV vers Google Drive (optionnel) ----------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_CV_FOLDER_ID=

# --- Analytics (optionnel, chargé après consentement) -----------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Héritage plateforme Manus (à retirer après migration complète) ---------
# Utilisées par le proxy /manus-storage, l'ancien OAuth et les tâches POST Manus.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Tests (développement uniquement) ---------------------------------------
# RUN_EXTERNAL_SECURITY_TESTS=false   # true = tests qui appellent Resend/Turnstile réels
# VISUAL_TEST_BASE_URL=http://localhost:3000
