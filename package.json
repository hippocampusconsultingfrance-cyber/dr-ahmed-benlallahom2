{
  "name": "dr-ahmed-benlallahom",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "NODE_ENV=production vite build && tsx scripts/prerender-route-seo.ts && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/vercelEntry.ts --platform=node --packages=external --bundle --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/vercel/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:visual": "REQUIRE_CHROMIUM=1 vitest run client/src/publicPages.browser.test.ts",
    "test:booking-keyboard": "node scripts/booking-keyboard-input.mjs",
    "emails:preview": "tsx scripts/emails-preview.mts",
    "validate:precheckpoint": "pnpm test:visual && pnpm vitest run client/src/components/visualRegressionHarness.test.ts client/src/components/graphicGovernance.test.ts && pnpm check",
    "check:performance": "pnpm build && node scripts/check-performance-budgets.mjs",
    "db:generate": "drizzle-kit generate"
  },
