                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                  <tr>
                    <td style="padding:0 14px 0 0;vertical-align:middle;"><img src="https://drahmedbenlallahom.com/assets/abl-logo.svg" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border:0;border-radius:8px;background:#ffffff;" /></td>
                    <td style="vertical-align:middle;font-family:Arial,sans-serif;"><div style="font-size:11px;letter-spacing:2px;font-weight:700;color:#38bdf8;">MD, DESAIC</div><div style="margin-top:5px;font-size:19px;font-weight:700;color:#ffffff;">Dr Ahmed Ben Lallahom</div></td>
